# Copy to .fork/build.env (gitignored) and fill in for your deployment.
# build.sh sources it; command-line flags override it.

# Registry to tag/push images to (host[:port][/namespace]). Required for --push.
FORK_REGISTRY=registry.example.internal:5000

# Image name under the registry. Default: firefly
#FORK_IMAGE_NAME=firefly

# Printed when the registry is unreachable on --push, e.g. the command that
# opens a tunnel/port-forward to it.
#FORK_REGISTRY_HINT="ssh -L 5000:registry:5000 bastion"

# Path to the repo holding the deployment manifests, for the post-push hint.
#FORK_DEPLOY_REPO=../my-deploy-repo
